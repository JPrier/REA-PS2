function(rea_ps2_attach_generated_code)
  file(TO_CMAKE_PATH "${REA_PS2_GENERATED_DIR}" REA_PS2_GENERATED_DIR)
  file(TO_CMAKE_PATH "${REA_PS2_NATIVE_OUTPUT}" REA_PS2_NATIVE_OUTPUT)
  get_property(attached GLOBAL PROPERTY REA_PS2_GENERATED_CODE_ATTACHED)
  if(attached)
    return()
  endif()
  if(NOT TARGET ps2EntryRunner)
    message(FATAL_ERROR "REA-PS2 integration hook ran before PS2Recomp defined ps2EntryRunner")
  endif()
  if(NOT IS_DIRECTORY "${REA_PS2_GENERATED_DIR}")
    message(FATAL_ERROR "Generated source directory does not exist: ${REA_PS2_GENERATED_DIR}")
  endif()
  file(GLOB generated_sources CONFIGURE_DEPENDS "${REA_PS2_GENERATED_DIR}/*.cpp")
  if(NOT generated_sources)
    message(FATAL_ERROR "No generated C++ source files found in ${REA_PS2_GENERATED_DIR}")
  endif()
  get_target_property(runner_sources ps2EntryRunner SOURCES)
  set(filtered_runner_sources "")
  foreach(source IN LISTS runner_sources)
    file(TO_CMAKE_PATH "${source}" normalized_source)
    if(normalized_source MATCHES "/ps2xRuntime/src/runner/register_functions\\.cpp$")
      message(STATUS "REA-PS2 removed upstream placeholder function table: ${source}")
    else()
      list(APPEND filtered_runner_sources "${source}")
    endif()
  endforeach()
  set_property(TARGET ps2EntryRunner PROPERTY SOURCES "${filtered_runner_sources}")
  target_sources(ps2EntryRunner PRIVATE ${generated_sources})
  target_include_directories(ps2EntryRunner PRIVATE "${REA_PS2_GENERATED_DIR}")
  target_compile_definitions(ps2EntryRunner PRIVATE PS2_FUNCTION_LOG_TRACKER=1)
  set_target_properties(ps2EntryRunner PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY "${REA_PS2_NATIVE_OUTPUT}/$<CONFIG>"
    UNITY_BUILD OFF
  )
  set_property(GLOBAL PROPERTY REA_PS2_GENERATED_CODE_ATTACHED TRUE)
  message(STATUS "REA-PS2 attached ${generated_sources} to ps2EntryRunner")
endfunction()

cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL rea_ps2_attach_generated_code)
